<?xml version="1.0" encoding="UTF-8"?>
<!--
  The regression suite of the Apache app, run by ../runTests.sh inside
  the test container (tests/README.md). Four suites, cheapest first:
  Unit checks pure helpers without the app, Feature drives the app
  in-process with every test inside a rolled-back transaction, Http
  talks to the real Apache over HTTP, and Defects pins the known bugs.
  The server values switch the in-process app to its testing setup;
  Apache keeps the production environment run.sh gives it.
  displayDetailsOnIncompleteTests lists every pinned known defect after
  a run.
-->
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         cacheResult="false"
         failOnRisky="true"
         failOnWarning="true"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnSkippedTests="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
        <testsuite name="Http">
            <directory suffix="Test.php">./tests/Http</directory>
        </testsuite>
        <testsuite name="Defects">
            <directory suffix="Test.php">./tests/Defects</directory>
        </testsuite>
    </testsuites>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
    </php>
</phpunit>
