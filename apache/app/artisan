#!/usr/bin/env php
<?php

// -----------------------------------------------------------
//  [*] artisan — the console entry point
//
//  Laravel's command line: builds the app
//  (bootstrap/app.php) and runs the command named in its
//  arguments through the console kernel; the command's
//  status becomes the exit code. The image build runs it
//  once — composer install calls package:discover, which
//  writes the package manifest to bootstrap/cache — and
//  nothing runs it after that: no migration, no seeder, no
//  schedule. It lies outside public/, so Apache never
//  serves it. Laravel 10's stock file, unchanged.
//
//  Used by:
//    - composer install in apache/Dockerfile — the
//      post-autoload-dump script of composer.json runs
//      package:discover
// -----------------------------------------------------------


// The moment the command started; nothing in the app reads
// it
define('LARAVEL_START', microtime(true));

// Composer's class loader, then the application as
// bootstrap/app.php builds it
require __DIR__.'/vendor/autoload.php';

$app = require_once __DIR__.'/bootstrap/app.php';

// The console kernel runs the command the arguments name
// and returns its exit status
$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);

$status = $kernel->handle(
    $input = new Symfony\Component\Console\Input\ArgvInput,
    new Symfony\Component\Console\Output\ConsoleOutput
);

// The kernel's closing work, then the status as the
// process's exit code
$kernel->terminate($input, $status);

exit($status);
